            "fact": "dx_osteoporosis",
            "op": "is_true"
          },
          {
            "any": [
              {
                "fact": "dx_sarcopenia_any",
                "op": "is_true"
              },
              {
                "fact": "dx_possible_sarcopenia",
                "op": "is_true"
              }
            ]
          }
        ]
      },
      "citation": "《老年人骨质疏松症诊疗与管理专家共识》骨肌共病",
      "tags": [
        "骨肌共病"
      ]
    },
    {
      "rec_id": "CN.OP.2022.VERTEBRAL_IMAGING",
      "source_id": "CN.OP.2022",
      "topic": "screening",
      "question": "q.screen.vertebral_imaging",
      "action": "vertebral_fracture_assessment",
      "direction": "recommend",
      "strength": "consensus",
      "statement_zh": "身高较年轻时下降 >4 cm、一年内下降 >2 cm、出现驼背或不明原因背痛者，应行胸腰椎侧位 X 线片或 VFA 查找无症状椎体骨折。",
      "applies_when": {
        "any": [
          {
            "fact": "height_loss_cm",
            "op": ">=",
            "value": 4
          },
          {
            "fact": "age",
            "op": ">=",
            "value": 70
          },
          {
            "fact": "glucocorticoid_current",
            "op": "is_true"
          }
        ]
      },
      "excluded_when": {
        "fact": "vertebral_imaging_done",
        "op": "is_true"
      },
      "rationale": "约三分之二的椎体骨折无症状，靠「痛不痛」筛不出来，而一处椎体骨折就改变风险分层与用药选择。",
      "citation": "《原发性骨质疏松症诊疗指南（2022）》椎体骨折评估",
      "tags": [
        "筛查",
        "椎体骨折",
        "VFA"
      ]
    }
  ]
